rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isShortString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isOptionalShortString(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    function isTimestampOrNull(value) {
      return value == null || value is timestamp;
    }

    function isFcmPlatform(value) {
      return value == 'android' ||
        value == 'ios' ||
        value == 'web' ||
        value == 'unknown';
    }

    function isUserBookStatus(value) {
      return value == 'AVAILABLE' || value == 'ARCHIVED';
    }

    function validWishlistEntry(data) {
      return data.keys().hasOnly([
          'addedAt'
        ]) &&
        data.addedAt is timestamp;
    }

    function validUserBook(data) {
      return data.keys().hasOnly([
          'ownerId',
          'catalogBookId',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        isShortString(data.ownerId, 6, 128) &&
        isShortString(data.catalogBookId, 2, 128) &&
        isUserBookStatus(data.status) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validClientUserProfile(data) {
      return data.keys().hasOnly([
          'displayName',
          'email',
          'photoUrl',
          'notificationsEnabled',
          'createdAt',
          'updatedAt',
          'uid', 'searchableDisplayName', 'photoURL', 'notificationPreferences', 'lastSeenAt',
          'libraryShared', 'libraryName', 'hiddenCatalogIds', 'publicationEpoch', 'librarySharingBlocked'
        ]) &&
        isShortString(data.displayName, 1, 80) &&
        isOptionalShortString(data.get('email', null), 320) &&
        (data.get('photoUrl', null) == null || isShortString(data.photoUrl, 1, 2048)) &&
        data.get('notificationsEnabled', true) is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function activeOwner(ownerUid, epoch) {
      let gate = get(/databases/$(database)/documents/publicLibraryState/$(ownerUid));
      return gate.data.published == true && gate.data.publicationEpoch == epoch;
    }

    function activeLibrary(ownerUid, epoch) {
      let parent = get(/databases/$(database)/documents/sharedLibraries/$(ownerUid));
      return parent.data.published == true && parent.data.publicationEpoch == epoch &&
        activeOwner(ownerUid, epoch);
    }

    function activeReader(ownerUid, epoch) {
      let parent = get(/databases/$(database)/documents/sharedReaders/$(ownerUid));
      return parent.data.published == true && parent.data.publicationEpoch == epoch &&
        activeOwner(ownerUid, epoch);
    }

    function activeCollection(ownerUid, collectionId, epoch) {
      let parent = get(/databases/$(database)/documents/sharedReaders/$(ownerUid)/collections/$(collectionId));
      return parent.data.published == true && parent.data.publicationEpoch == epoch &&
        activeReader(ownerUid, epoch);
    }

    match /publicLibraryState/{ownerUid} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    match /sharedLibraries/{ownerUid} {
      allow get: if isSignedIn() && resource.data.published == true &&
        activeOwner(ownerUid, resource.data.publicationEpoch);
      // No per-result gate reads: callable revocation atomically removes this flag.
      allow list: if isSignedIn() && request.query.limit <= 20 &&
        resource.data.published == true;
      allow write: if false;
      match /books/{catalogId} {
        allow get: if isSignedIn() && activeLibrary(ownerUid, resource.data.publicationEpoch);
        allow list: if isSignedIn() && request.query.limit <= 60 &&
          activeLibrary(ownerUid, resource.data.publicationEpoch);
        allow write: if false;
      }
    }

    match /sharedReaders/{ownerUid} {
      allow get: if isSignedIn() && resource.data.published == true &&
        activeOwner(ownerUid, resource.data.publicationEpoch);
      allow list, write: if false;
      match /collections/{collectionId} {
        allow get: if isSignedIn() && resource.data.published == true &&
          activeReader(ownerUid, resource.data.publicationEpoch);
        allow list: if isSignedIn() && request.query.limit <= 60 &&
          resource.data.published == true && activeReader(ownerUid, resource.data.publicationEpoch);
        allow write: if false;
        match /books/{catalogId} {
          allow get: if isSignedIn() && activeCollection(ownerUid, collectionId, resource.data.publicationEpoch);
          allow list: if isSignedIn() && request.query.limit <= 60 &&
            activeCollection(ownerUid, collectionId, resource.data.publicationEpoch);
          allow write: if false;
        }
      }
    }

    function validFcmToken(data) {
      return data.keys().hasOnly([
          'token',
          'platform',
          'createdAt',
          'updatedAt',
          'lastSeenAt',
          'appVersion'
        ]) &&
        isShortString(data.token, 20, 4096) &&
        isFcmPlatform(data.platform) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.lastSeenAt is timestamp &&
        isOptionalShortString(data.appVersion, 64);
    }

    function isLoanParticipant(data) {
      return isSignedIn() &&
        (request.auth.uid in data.get('participants', []) ||
          data.get('lenderUid', null) == request.auth.uid ||
          data.get('borrowerUid', null) == request.auth.uid);
    }

    function isInviteViewer(data) {
      return isSignedIn() &&
        (data.lenderUid == request.auth.uid ||
          (data.status == 'accepted' &&
            data.borrowerUid == request.auth.uid));
    }

    function notificationUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRead',
          'readAt',
          'updatedAt'
        ]) &&
        request.resource.data.recipientUid == resource.data.recipientUid &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.body == resource.data.body &&
        request.resource.data.actorUid == resource.data.actorUid &&
        request.resource.data.loanId == resource.data.loanId &&
        request.resource.data.inviteId == resource.data.inviteId &&
        request.resource.data.catalogBookId == resource.data.catalogBookId &&
        request.resource.data.data == resource.data.data &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.push == resource.data.push &&
        request.resource.data.isRead is bool &&
        isTimestampOrNull(request.resource.data.readAt) &&
        request.resource.data.updatedAt is timestamp;
    }

    match /catalog/{bookId} {
      allow read: if true;
      allow write: if false;
    }

    match /catalogBooks/{bookId} {
      allow read: if true;
      allow write: if false;
    }

    match /isbnLookupCache/{isbn13} {
      allow read, write: if false;
    }

    match /isbnLookupThrottle/{userId} {
      allow read, write: if false;
    }

    match /userBooks/{copyId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        validUserBook(request.resource.data);
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.catalogBookId == resource.data.catalogBookId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        validUserBook(request.resource.data);
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) && validClientUserProfile(request.resource.data) &&
        request.resource.data.keys().hasAll([
          'displayName', 'email', 'photoUrl', 'notificationsEnabled', 'createdAt', 'updatedAt'
        ]) &&
        !request.resource.data.keys().hasAny([
          'uid', 'searchableDisplayName', 'photoURL', 'notificationPreferences', 'lastSeenAt',
          'libraryShared', 'libraryName', 'hiddenCatalogIds', 'publicationEpoch', 'librarySharingBlocked'
        ]);
      allow update: if isSelf(userId) && validClientUserProfile(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'photoUrl', 'notificationsEnabled', 'createdAt', 'updatedAt'
        ]);
      allow delete: if false;

      match /collections/{collectionId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }
      match /fcmTokens/{tokenId} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId) && validFcmToken(request.resource.data);
        allow delete: if isSelf(userId);
      }

      match /wishlist/{catalogId} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId) && validWishlistEntry(request.resource.data);
        allow delete: if isSelf(userId);
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSelf(resource.data.recipientUid);
      allow update: if isSelf(resource.data.recipientUid) && notificationUpdateAllowed();
      allow create, delete: if false;
    }

    match /loanInvites/{inviteId} {
      allow read: if isInviteViewer(resource.data);
      allow write: if false;
    }

    match /loanInviteCodes/{code} {
      allow read, write: if false;
    }

    match /loans/{loanId} {
      allow read: if isLoanParticipant(resource.data);
      allow write: if false;
    }

    match /lendingSlots/{slotId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
